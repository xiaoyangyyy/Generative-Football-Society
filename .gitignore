# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment files
.env
.env.*
!.env.example
!deploy/.env.deploy.example

# Runtime outputs
outputs/
backups/
deploy/secrets/
logs/
reports/*
data/evaluation/shards/
!reports/acceptance/
reports/acceptance/*
!reports/acceptance/*.json
reports/acceptance/*.checkpoint.json
reports/acceptance/*smoke*.json
*.log

# Live tournament / LLM cache (regenerated on run)
data/persistence/
data/cache/
data/world_model/traces/

# Large external dumps (re-fetch via scripts/fetch_football_baseline.py)
data/external/transfermarkt/*.csv.gz
data/external/transfermarkt/players.csv.gz
data/external/*/raw/
data/external/*/derived/*.csv

# Cursor / local tooling
.cursor/

# Tests / coverage
.coverage
htmlcov/
.tox/

# Build / dist
dist/
build/

# IDE and OS files
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
