# LLM - OpenAI-compatible API
# Use either API_KEY or OPENAI_API_KEY (read at call time by the gateway).
API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4-turbo-preview

# Simulation
LOG_LEVEL=INFO
GFS_SEED=42
# Optional when the installed gfs command runs outside the repository.
# GFS_PROJECT_ROOT=D:/path/to/GFS-sparse

# Match engines
# MATCH_MICRO=1
# MATCH_COGNITIVE=1
# MATCH_BALL_LOG=1
# MATCH_BALL_LOG_MAX=800
# MATCH_BALL_LOG_TXT=0
# MATCH_WM_SNAPSHOT_IN_BALL_LOG=0
# MATCH_COGNITIVE_CACHE=data/cache/cognitive
# MATCH_MACRO_MICRO_ETA=0.55
