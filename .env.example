# LLM Configuration (OpenAI-compatible API)
# Use either API_KEY or OPENAI_API_KEY (both are read by src/config.py).
API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4-turbo-preview

# Simulation Settings
LOG_LEVEL=INFO
DEBUG_MODE=false
# Optional: fixed RNG for reproducible runs (see src/simulation/random_control.py)
# GFS_SEED=42
