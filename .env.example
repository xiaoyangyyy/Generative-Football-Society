# LLM - DeepSeek via its OpenAI-compatible API
# Never commit a real key. Rotate any credential pasted into chat or logs.
DEEPSEEK_API_KEY=replace_with_rotated_key
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Independent product login secret for authenticated remote Web deployment.
# Generate at least 32 random characters; never reuse a provider API key.
GFS_WEB_ACCESS_TOKEN=replace_with_random_token
# Preferred for container deployment; do not set both token variables.
GFS_WEB_ACCESS_TOKEN_FILE=
GFS_WEB_ALLOWED_HOSTS=studio.example.com
# Generic providers may instead use API_KEY or OPENAI_API_KEY.

# Simulation
LOG_LEVEL=INFO
GFS_SEED=42
# Optional when the installed gfs command runs outside the repository.
# GFS_PROJECT_ROOT=D:/path/to/GFS-sparse

# Match engines
# MATCH_MICRO=1
# MATCH_COGNITIVE=1
# MATCH_BALL_LOG=1
# MATCH_BALL_LOG_MAX=800
# MATCH_BALL_LOG_TXT=0
# MATCH_WM_SNAPSHOT_IN_BALL_LOG=0
# MATCH_COGNITIVE_CACHE=data/cache/cognitive
# MATCH_MACRO_MICRO_ETA=0.55
