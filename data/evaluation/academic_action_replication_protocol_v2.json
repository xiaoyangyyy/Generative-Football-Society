{
  "schema_version": 1,
  "protocol_id": "gfs-action-policy-external-replication-v2",
  "state": "registered_post_result_before_replication",
  "objective": "Replicate the completed action-policy result on disjoint fixtures and independent seeds, isolate the contribution of the active action policy from prediction-only execution, and test external scale against the licensed IDSSE sample. This protocol was frozen after the primary result and before any V2 replication run.",
  "prerequisite": {
    "confirmatory_protocol": "data/evaluation/action_outcome_protocol_v1.json",
    "confirmatory_decision": "data/evaluation/action_outcome_v1/decision.json",
