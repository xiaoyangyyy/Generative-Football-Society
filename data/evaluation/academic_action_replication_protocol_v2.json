      "promotion_candidate_pending_release_review",
      "no_meaningful_difference_keep_research_only",
      "inconclusive_keep_research_only"
    ],
    "observed_decision_at_registration": "inconclusive_keep_research_only",
    "branch_is_selected_only_from_confirmatory_decision": true
  },
  "branches": {
    "promotion_candidate_pending_release_review": {
      "branch_id": "mechanism_confirmation",
      "required_conclusion": "replicated_improvement_and_planning_contribution"
    },
    "no_meaningful_difference_keep_research_only": {
      "branch_id": "adoption_path_diagnosis",
      "required_conclusion": "replicated_equivalence_and_planning_nonadoption"
    },
    "inconclusive_keep_research_only": {
      "branch_id": "variance_diagnosis",
      "required_conclusion": "bounded_inconclusive_replication"
    }
  },
  "arms": [
    {
      "arm_id": "M0",
      "role": "physics_competitive_baseline",
      "world_model": false,
      "planning": false
    },
    {
      "arm_id": "M1_predict_only",
      "role": "same_checkpoint_prediction_only_negative_control",
      "world_model": true,
      "planning": false
    },
    {
      "arm_id": "M1",
      "role": "mechanism_confirmed_action_policy_candidate",
      "world_model": true,
      "planning": true
    }
  ],
  "design": {
    "experimental_unit": "matched_fixture_seed_triplet",
    "fixtures": [
      ["Austria", "Switzerland"],
      ["Canada", "United States"],
      ["Algeria", "Ghana"],
      ["Australia", "Japan"],
      ["Norway", "Sweden"],
      ["Ecuador", "Colombia"]
    ],
    "fixtures_disjoint_from_confirmatory_teams": true,
    "sample_indices": [0, 1, 2, 3],
    "seed_start": 361000,
    "match_seconds": 5400.0,
    "units_per_arm": 24,
    "runs_total": 72,
    "arm_order": ["M0", "M1_predict_only", "M1"],
    "provider_calls_authorized": false,
    "training_authorized": false,
    "explicit_execution_token": "I_AUTHORIZE_GFS_ACTION_REPLICATION_V2"
  },
  "analysis": {
    "method": "fixture_stratified_paired_bootstrap",
    "bootstrap_draws": 10000,
    "bootstrap_seed": 361000,
    "confidence_level": 0.95,
    "confirmatory_meaningful_delta_loss": 0.1,
    "planning_contribution_delta_loss": 0.05,
    "planning_nonadoption_equivalence_margin": 0.02,
    "inconclusive_maximum_interval_width": 0.2,
    "behavior_change_tolerance": 1e-7,
    "minimum_changed_pair_fraction": 0.1,
    "secondary_metrics_role": "descriptive_only",
    "multiplicity": "The variance-diagnosis branch and both ordered comparisons were frozen after the primary decision and before V2 replication outcomes; no fixture, branch, threshold, or metric may be selected from V2 results."
  },
  "external_validity": {
