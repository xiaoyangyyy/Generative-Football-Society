{
  "schema_version": 1,
  "package_id": "gfs-registered-report-reproduction-v1",
  "stage": "preexecution_auditable_package",
  "scope": "Existing evidence, manuscript claims, and the preregistered confirmatory workflow; no new simulation is part of package verification.",
  "artifacts": {
    "manuscript": "docs/PAPER_DRAFT.md",
    "claims": "data/evaluation/paper_claims_v1.json",
    "protocol": "data/evaluation/formal_experiment_protocol_v2.json",
    "protocol_documentation": "docs/FORMAL_EXPERIMENT_PROTOCOL_V2.md",
    "reproduction_guide": "docs/REPRODUCTION_GUIDE.md",
    "model_card": "docs/RESEARCH_MODEL_CARD.md",
    "data_card": "docs/RESEARCH_DATA_CARD.md",
    "references": "docs/PAPER_REFERENCES.bib",
    "environment_snapshot": "data/evaluation/reproduction_environment_v1.json",
    "dependency_lock_contract": "data/evaluation/dependency_lock_contract_v1.json",
    "data_license_registry": "data/evaluation/data_license_registry_v1.json",
    "existing_evidence": "data/evaluation/research_evidence_v1.json",
    "prior_m1_decision": "data/evaluation/formal_ablation/M1_calibrated_decision.json",
    "runner": "scripts/run_formal_experiment.py",
    "package_verifier": "scripts/verify_paper_package.py",
    "release_verifier": "scripts/verify_reproduction_release.py"
  },
  "commands": [
    {
      "id": "package_audit",
      "command": "python scripts/verify_paper_package.py",
      "effect": "read_only",
      "runs_simulation": false,
      "explicit_authority_required": false
    },
    {
      "id": "evidence_audit",
      "command": "python scripts/audit_research_evidence.py --check",
      "effect": "read_only",
      "runs_simulation": false,
      "explicit_authority_required": false
    },
    {
      "id": "reproduction_release_audit",
      "command": "python scripts/verify_reproduction_release.py",
      "effect": "read_only",
      "runs_simulation": false,
      "explicit_authority_required": false
    },
    {
      "id": "experiment_status",
      "command": "python scripts/run_formal_experiment.py",
      "effect": "read_only",
      "runs_simulation": false,
      "explicit_authority_required": false
    },
    {
      "id": "confirmatory_execution",
      "command": "python scripts/run_formal_experiment.py --execute",
      "effect": "fixed_60_run_simulation",
      "runs_simulation": true,
      "explicit_authority_required": true
    },
    {
      "id": "complete_only_analysis",
      "command": "python scripts/run_formal_experiment.py --analyze",
      "effect": "analysis_only_after_complete_identity_matched_evidence",
      "runs_simulation": false,
      "explicit_authority_required": true
    }
  ],
  "expected_confirmatory_outputs": {
    "progress": "data/evaluation/formal_confirmatory_v2/progress.json",
    "decision": "data/evaluation/formal_confirmatory_v2/decision.json",
    "current_status": "absent_not_executed"
  },
  "data_distribution": {
    "status": "known_sources_registered_default_deny",
    "redistribution_blanket_claim": false,
    "license_review_complete": false,
    "known_source_registry_complete": true,
    "registry": "data/evaluation/data_license_registry_v1.json",
    "note": "All five known external source families have a release decision, but unresolved license scope keeps every external artifact excluded from an archive."
  },
  "environment": {
    "status": "exact_direct_dependencies_not_transitively_hash_locked",
    "container_base_pinned": "python:3.12.11-slim-bookworm",
    "direct_dependencies_pinned": true,
    "full_transitive_hash_lock": false
  },
  "independent_reproduction": {
    "status": "not_performed",
    "reviewer_independent_of_implementation": null,
    "report": null
  },
  "archive": {
    "status": "not_built",
    "reason": "A verified manifest is provided first; no archive is claimed until licensing and independent reproduction gates are complete."
  }
}
